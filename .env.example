# 当前启用的配置档：qwen 或 deepseek
LLM_PROVIDER=qwen

# 阿里云百炼千问
QWEN_API_KEY=
QWEN_MODEL_ID=qwen3.7-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# RAG v2 使用的 DeepSeek 模型名；与 Agent 的 MODEL_ID 配置相互独立
DEEPSEEK_MODEL=deepseek-chat

# RAG v2：SiliconFlow BGE-M3 与 PostgreSQL
# 仅设为 true 时，DKAgent 才注册 query_knowledge_base Tool
RAG_ENABLED=false
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
DATABASE_URL=postgresql://rag:rag@localhost:5439/rag
RAG_VAULT_PATH=

# RAG v2：可选拒答阈值，必须通过当前评估集校准后再填写
RAG_MIN_SIMILARITY=

# 两个配置档共用的 Token 限制
LLM_CONTEXT_WINDOW_TOKENS=1000000
LLM_MAX_OUTPUT_TOKENS=20000
