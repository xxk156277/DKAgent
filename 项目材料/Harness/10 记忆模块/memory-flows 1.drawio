        <mxCell id="o-drop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="不保存：临时信息 / 非法候选 / 凭据" vertex="1">
