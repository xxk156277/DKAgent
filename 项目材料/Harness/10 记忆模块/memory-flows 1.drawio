        </mxCell>
        <mxCell id="o-b-input" parent="o-recall-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;b&gt;新用户输入&lt;/b&gt;" vertex="1">
