        </mxCell>
        <mxCell id="oe10" edge="1" parent="o-recall-lane" source="o-formatter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="o-context" value="recalled_memory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-b-loop" parent="o-recall-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" value="&lt;b&gt;AgentLoop&lt;/b&gt;&lt;br&gt;同一 Turn 多 Step&lt;br&gt;复用同一份 Memory" vertex="1">
