        </mxCell>
        <mxCell id="oe11" edge="1" parent="o-recall-lane" source="o-context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="o-b-loop" value="ContextSnapshot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o-b-answer" parent="o-recall-lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="&lt;b&gt;最终回答&lt;/b&gt;&lt;br&gt;完成后再次提取" vertex="1">
          <mxGeometry height="80" width="220" x="1480" y="115" as="geometry" />
        </mxCell>
        <mxCell id="oe12" edge="1" parent="o-recall-lane" source="o-b-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" target="o-b-answer">
