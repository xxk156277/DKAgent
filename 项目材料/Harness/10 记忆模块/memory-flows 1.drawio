        <mxCell id="oe-db-read" edge="1" parent="1" source="o-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="o-retriever" value="跨进程读取">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1640" y="425" />
              <mxPoint x="415" y="425" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="o-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;" value="&lt;b&gt;说明&lt;/b&gt;&lt;br&gt;Memory 只保存跨 Session 仍有价值的稳定信息。它对单轮 AgentLoop 的影响只有两个扩展点：Turn 开始前召回，完整回答结束后提取。召回内容只进入本轮 Context，不进入 canonical messages，也不是 Session 历史副本。" vertex="1">
          <mxGeometry height="130" width="1040" x="380" y="840" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
