<mxGraphModel dx="1949" dy="1222" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o-title" value="DKAgent Memory：跨 Session 写入与召回" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="430" y="20" width="760" height="40" as="geometry"/></mxCell><mxCell id="o-write-lane" value="Session A：形成长期记忆" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="60" y="90" width="1680" height="330" as="geometry"/></mxCell><mxCell id="o-a-input" value="&lt;b&gt;用户输入&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="o-write-lane" vertex="1"><mxGeometry x="40" y="115" width="150" height="60" as="geometry"/></mxCell><mxCell id="o-a-loop" value="&lt;b&gt;AgentLoop&lt;/b&gt;&lt;br&gt;模型 / Tool 循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="o-write-lane" vertex="1"><mxGeometry x="240" y="105" width="190" height="80" as="geometry"/></mxCell><mxCell id="o-answer" value="&lt;b&gt;最终完整回答&lt;/b&gt;&lt;br&gt;stopReason = end_turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="o-write-lane" vertex="1"><mxGeometry x="480" y="105" width="210" height="80" as="geometry"/></mxCell><mxCell id="o-extractor" value="&lt;b&gt;MemoryExtractor&lt;/b&gt;&lt;br&gt;提出 0～3 条候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="o-write-lane" vertex="1"><mxGeometry x="740" y="105" width="210" height="80" as="geometry"/></mxCell><mxCell id="o-validate" value="&lt;b&gt;程序校验&lt;/b&gt;&lt;br&gt;类型 / key / 凭据 / 去重" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" parent="o-write-lane" vertex="1"><mxGeometry x="1000" y="90" width="210" height="110" as="geometry"/></mxCell><mxCell id="o-store" value="&lt;b&gt;MemoryStore.upsert&lt;/b&gt;&lt;br&gt;显式记忆优先" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="o-write-lane" vertex="1"><mxGeometry x="1260" y="105" width="200" height="80" as="geometry"/></mxCell><mxCell id="o-db" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;.dkagent/memory.db" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="o-write-lane" vertex="1"><mxGeometry x="1510" y="95" width="130" height="100" as="geometry"/></mxCell><mxCell id="o-drop" value="不保存&lt;br&gt;临时信息 / 非法候选 / 凭据" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" parent="o-write-lane" vertex="1"><mxGeometry x="1000" y="235" width="210" height="65" as="geometry"/></mxCell><mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-write-lane" source="o-a-input" target="o-a-loop" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-write-lane" source="o-a-loop" target="o-answer" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe3" value="回答完成后" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-write-lane" source="o-answer" target="o-extractor" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe4" value="候选" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-write-lane" source="o-extractor" target="o-validate" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe5" value="合法" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" parent="o-write-lane" source="o-validate" target="o-store" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe6" value="非法" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="o-write-lane" source="o-validate" target="o-drop" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe7" value="持久化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" parent="o-write-lane" source="o-store" target="o-db" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o-recall-lane" value="Session B：重新启动后的记忆召回" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="60" y="470" width="1680" height="350" as="geometry"/></mxCell><mxCell id="o-b-input" value="&lt;b&gt;新用户输入&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="o-recall-lane" vertex="1"><mxGeometry x="40" y="120" width="160" height="60" as="geometry"/></mxCell><mxCell id="o-retriever" value="&lt;b&gt;MemoryRetriever&lt;/b&gt;&lt;br&gt;读取最近 100 条并筛选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="o-recall-lane" vertex="1"><mxGeometry x="250" y="105" width="220" height="90" as="geometry"/></mxCell><mxCell id="o-formatter" value="&lt;b&gt;MemoryFormatter&lt;/b&gt;&lt;br&gt;安全标签 + 2000 字符预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="o-recall-lane" vertex="1"><mxGeometry x="530" y="105" width="230" height="90" as="geometry"/></mxCell><mxCell id="o-context" value="&lt;b&gt;ContextManager&lt;/b&gt;&lt;br&gt;注入 System Prompt&lt;br&gt;并计算 Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="o-recall-lane" vertex="1"><mxGeometry x="820" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="o-b-loop" value="&lt;b&gt;AgentLoop&lt;/b&gt;&lt;br&gt;同一 Turn 多 Step&lt;br&gt;复用同一份 Memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="o-recall-lane" vertex="1"><mxGeometry x="1100" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="o-b-answer" value="&lt;b&gt;最终回答&lt;/b&gt;&lt;br&gt;完成后再次提取 Memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="o-recall-lane" vertex="1"><mxGeometry x="1380" y="105" width="220" height="90" as="geometry"/></mxCell><mxCell id="oe8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-recall-lane" source="o-b-input" target="o-retriever" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe9" value="召回结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-recall-lane" source="o-retriever" target="o-formatter" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe10" value="recalled_memory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-recall-lane" source="o-formatter" target="o-context" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe11" value="ContextSnapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-recall-lane" source="o-context" target="o-b-loop" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="oe12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" parent="o-recall-lane" source="o-b-loop" target="o-b-answer" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o-db-read" value="跨进程读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="o-db" target="o-retriever" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1575" y="445"/><mxPoint x="420" y="445"/></Array></mxGeometry></mxCell><mxCell id="o-note" value="&lt;b&gt;文字说明&lt;/b&gt;&lt;br&gt;1. Memory 只保存跨 Session 仍有价值的稳定信息。&lt;br&gt;2. 单轮循环只增加“开始前召回、结束后提取”。&lt;br&gt;3. Memory 不进入 canonical messages，也不是 Session 历史副本。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;" parent="1" vertex="1"><mxGeometry x="420" y="860" width="960" height="150" as="geometry"/></mxCell></root></mxGraphModel>