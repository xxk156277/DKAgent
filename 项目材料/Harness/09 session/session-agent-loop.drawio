<mxGraphModel dx="3749" dy="1258" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DKAgent：Session 生命周期与单轮 AgentLoop" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="70" y="20" width="960" height="40" as="geometry"/></mxCell><mxCell id="session-lane" value="Session 生命周期（跨轮次、跨进程）" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="-910" y="80" width="1470" height="900" as="geometry"/></mxCell><mxCell id="session-note" value="&lt;b&gt;关键边界&lt;/b&gt;&lt;br&gt;CLI 与 Store 一直保留；切换 Session 时重建 AgentLoop，不在旧 Loop 上替换状态。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="session-lane" vertex="1"><mxGeometry x="570" y="770" width="370" height="115" as="geometry"/></mxCell><mxCell id="loop-lane" value="普通输入：一次 AgentLoop.run()" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="580" y="80" width="1210" height="1210" as="geometry"/></mxCell><mxCell id="history-note" value="&lt;b&gt;两份状态同时存在&lt;/b&gt;&lt;br&gt;1. AgentLoop.messages：当前进程中的完整原始历史&lt;br&gt;2. SQLite：跨进程可恢复的完整历史&lt;br&gt;ContextSnapshot 只是每次请求模型时的预算内视图。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;" parent="loop-lane" vertex="1"><mxGeometry x="830" y="740" width="330" height="145" as="geometry"/></mxCell><mxCell id="step-loop" value="step ≤ maxSteps ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="502.5" y="180" width="150" height="90" as="geometry"/></mxCell><mxCell id="append-user" value="&lt;b&gt;appendMessage(user)&lt;/b&gt;&lt;br&gt;先写 Store，再写内存 messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="610" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="e-append-step" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="loop-lane" source="append-user" target="step-loop" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="context-build" value="&lt;b&gt;ContextManager.build()&lt;/b&gt;&lt;br&gt;预算、分组、裁剪、摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="467.5" y="332.5" width="220" height="75" as="geometry"/></mxCell><mxCell id="e-step-context" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" parent="loop-lane" source="step-loop" target="context-build" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="input" value="&lt;b&gt;普通用户输入&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="30" y="65" width="170" height="60" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;AgentLoop.run(input)&lt;/b&gt;&lt;br&gt;开始 agent.turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="300" y="60" width="210" height="70" as="geometry"/></mxCell><mxCell id="e-input-run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" parent="loop-lane" source="input" target="run" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-run-append" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" parent="loop-lane" source="run" target="append-user" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="save-context" value="nextContextState ?&lt;br&gt;store.saveContextState()&lt;br&gt;更新 Loop.contextState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="840" y="325" width="220" height="90" as="geometry"/></mxCell><mxCell id="e-context-state" value="可选 nextContextState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#82b366;" parent="loop-lane" source="context-build" target="save-context" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="append-tool-result" value="appendMessage(tool)&lt;br&gt;保存 toolCallId + result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="122.5" y="350" width="220" height="80" as="geometry"/></mxCell><mxCell id="next-step" value="进入下一 step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="145" y="195" width="175" height="60" as="geometry"/></mxCell><mxCell id="e-result-next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" parent="loop-lane" source="append-tool-result" target="next-step" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-next-context" value="继续 Loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="loop-lane" source="next-step" target="step-loop" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tool" value="&lt;b&gt;真实 Tool&lt;/b&gt;&lt;br&gt;执行并返回 result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="132.5" y="508" width="200" height="75" as="geometry"/></mxCell><mxCell id="e-tool-result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" parent="loop-lane" source="tool" target="append-tool-result" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="dispatcher" value="&lt;b&gt;dispatchToolCall()&lt;/b&gt;&lt;br&gt;Registry 查找 Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="130" y="660" width="205" height="75" as="geometry"/></mxCell><mxCell id="e-dispatch-tool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" parent="loop-lane" source="dispatcher" target="tool" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="append-tool-call" value="appendMessage(&lt;br&gt;assistant + toolCalls&lt;br&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="110" y="820" width="245" height="90" as="geometry"/></mxCell><mxCell id="e-toolcall-dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;" parent="loop-lane" source="append-tool-call" target="dispatcher" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="loop-lane" source="response-type" target="append-text" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="response-type" value="响应类型" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="502.5" y="820" width="150" height="90" as="geometry"/></mxCell><mxCell id="e-response-tool" value="tool_use" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;" parent="loop-lane" source="response-type" target="append-tool-call" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="request-snapshot" value="&lt;b&gt;ContextSnapshot&lt;/b&gt;&lt;br&gt;本轮模型请求视图&lt;br&gt;不覆盖完整历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="475" y="455" width="205" height="90" as="geometry"/></mxCell><mxCell id="e-context-snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" parent="loop-lane" source="context-build" target="request-snapshot" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="query" value="&lt;b&gt;QueryEngine.query()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="487.5" y="590" width="180" height="60" as="geometry"/></mxCell><mxCell id="e-snapshot-query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" parent="loop-lane" source="request-snapshot" target="query" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM Provider&lt;/b&gt;&lt;br&gt;text 或 tool_use" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="475" y="685" width="205" height="105" as="geometry"/></mxCell><mxCell id="e-llm-response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" parent="loop-lane" source="llm" target="response-type" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-query-llm" value="stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" parent="loop-lane" source="query" target="llm" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="append-text" value="&lt;b&gt;文本回答&lt;/b&gt;&lt;br&gt;appendMessage(assistant)&lt;br&gt;返回本轮答案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="loop-lane" vertex="1"><mxGeometry x="465" y="940" width="225" height="90" as="geometry"/></mxCell><mxCell id="answer" value="&lt;b&gt;CLI 输出回答&lt;/b&gt;&lt;br&gt;等待下一轮输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="465" y="1070" width="225" height="75" as="geometry"/></mxCell><mxCell id="e-text-answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" parent="loop-lane" source="append-text" target="answer" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="trace-note" value="&lt;b&gt;Tracer 横切整个流程&lt;/b&gt;&lt;br&gt;agent.turn → agent.step → model.request → tool.call&lt;br&gt;只负责观测，不持有 Session 状态。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="loop-lane" vertex="1"><mxGeometry x="830" y="557.5" width="330" height="125" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;SqliteSessionStore&lt;/b&gt;&lt;br&gt;Session 持久化端口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1"><mxGeometry x="310" y="522.5" width="205" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;sessions&lt;br&gt;session_messages" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" parent="1" vertex="1"><mxGeometry x="325" y="692.5" width="175" height="100" as="geometry"/></mxCell><mxCell id="cmd-list" value="&lt;b&gt;/sessions&lt;/b&gt;&lt;br&gt;store.list()&lt;br&gt;* 标记当前 Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1"><mxGeometry x="-580" y="580" width="205" height="80" as="geometry"/></mxCell><mxCell id="cmd-new"