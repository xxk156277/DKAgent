1" as="geometry"><Array as="points"><mxPoint x="-787" y="495"/></Array></mxGeometry></mxCell><mxCell id="e-cli-delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" parent="1" source="cli" target="cmd-delete" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-787" y="750"/></Array></mxGeometry></mxCell><mxCell id="e-new-current" value="新快照 + 新 Loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" parent="1" source="cmd-new" target="current" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-switch-current" value="全部成功后替换" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" parent="1" source="cmd-switch" target="current" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-delete-db" value="事务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" parent="1" source="cmd-delete" target="db" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cmd-switch" value="&lt;b&gt;/switch &amp;lt;id&amp;gt;&lt;/b&gt;&lt;br&gt;1. load(id)&lt;br&gt;2. createAgent(snapshot)&lt;br&gt;3. 最后替换当前引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="1" vertex="1"><mxGeometry x="-580" y="330" width="205" height="105" as="geometry"/></mxCell><mxCell id="e-cli-switch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" parent="1" source="cli" target="cmd-switch" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-787" y="390"/></Array></mxGeometry></mxCell><mxCell id="snapshot" value="&lt;b&gt;SessionSnapshot&lt;/b&gt;&lt;br&gt;id + messages&lt;br&gt;+ contextState + 时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1"><mxGeometry x="-240" y="150" width="205" height="90" as="geometry"/></mxCell><mxCell id="e-startup-snapshot" value="返回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" parent="1" source="startup" target="snapshot" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="startup" value="&lt;b&gt;启动恢复&lt;/b&gt;&lt;br&gt;loadLatest() ?? create()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;" parent="1" vertex="1"><mxGeometry x="310" y="160" width="205" height="70" as="geometry"/></mxCell><mxCell id="agent-instance" value="&lt;b&gt;AgentLoop 实例&lt;/b&gt;&lt;br&gt;恢复完整 messages&lt;br&gt;恢复 contextState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" parent="1" vertex="1"><mxGeometry x="110" y="342.5" width="225" height="90" as="geometry"/></mxCell><mxCell id="e-current-agent" value="createAgent(snapshot)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#9673a6;" parent="1" source="current" target="agent-instance" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;CLI / Readline&lt;/b&gt;&lt;br&gt;接收自然语言或 /command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1"><mxGeometry x="-890" y="522.5" width="205" height="70" as="geometry"/></mxCell><mxCell id="current" value="&lt;b&gt;CLI 当前引用&lt;/b&gt;&lt;br&gt;currentSession&lt;br&gt;agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" parent="1" vertex="1"><mxGeometry x="-240" y="347.5" width="205" height="80" as="geometry"/></mxCell></root></mxGraphModel>