        <mxCell id="n12" value="12. Skill只重跑&#xa;受影响的问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
