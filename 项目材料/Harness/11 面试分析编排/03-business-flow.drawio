        <mxCell id="n1" value="1. 用户提交文字稿路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="210" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="2. Agent提取并确认&#xa;公司、岗位、日期、轮次、可选JD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="3. Skill创建诊断任务&#xa;校验输入并保存Session阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="620" y="130" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="4. Tool读取原始文字稿&#xa;保留原文和全部表达痕迹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="130" width="260" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="5. LLM结构化文字稿&#xa;问题簇、全部问题、题型、项目事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="130" width="270" height="64" as="geometry"/>
        </mxCell>

        <mxCell id="n6" value="6. Skill遍历全部问题&#xa;过程性问题保留但不评分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1230" y="290" width="270" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="7. Tool按需检索知识库&#xa;仅核验八股题和技术事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="260" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="8. LLM按题型Rubric分析&#xa;输出问题、改进、分数、证据与置信度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="290" width="270" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="9. Skill汇总初步分析&#xa;保存检查点并暂停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="290" width="240" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="10. Agent集中询问&#xa;3～5个高影响事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="290" width="210" height="64" as="geometry"/>
