{
  "name": "@dkagent/agent",
  "private": true,
  "type": "module",
  "exports": {
    "./cli": "./src/cli/run.ts"
  },
  "scripts": {
    "agent": "cd ../.. && tsx packages/agent/src/index.ts",
    "test": "cd ../.. && tsx --test packages/agent/test/monorepo-layout.test.ts packages/agent/test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:phase1": "cd ../.. && tsx --test packages/agent/test/phase1/*.test.ts",
    "typecheck:phase1": "tsc -p tsconfig.phase1.json --noEmit",
    "test:context": "cd ../.. && tsx --test packages/agent/test/context/*.test.ts",
    "typecheck:context": "tsc -p tsconfig.context.json --noEmit",
    "test:session": "cd ../.. && tsx --test packages/agent/test/session/*.test.ts && node --test packages/agent/test/session/*.test.mjs",
    "typecheck:session": "tsc -p tsconfig.session.json --noEmit",
    "test:knowledge": "cd ../.. && tsx --test packages/agent/test/knowledge/*.test.ts",
    "typecheck:knowledge": "tsc -p tsconfig.knowledge.json --noEmit",
    "test:memory": "cd ../.. && tsx --test packages/agent/test/memory/*.test.ts",
    "typecheck:memory": "tsc -p tsconfig.memory.json --noEmit",
    "kb:build": "cd ../.. && tsx packages/agent/src/knowledge/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.34",
    "@ai-sdk/deepseek": "^3.0.24",
    "@ai-sdk/openai": "^4.0.34",
    "@dkagent/trace": "*",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.56",
    "anthropic": "^0.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "globby": "^16.2.3",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  }
}
