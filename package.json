{
    "name": "dkagent-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "scripts": {
        "agent": "pnpm --filter @dkagent/agent agent",
        "observe": "pnpm --filter @dkagent/web-tap observe",
        "dev": "pnpm --filter @dkagent/web-tap dev",
        "test": "pnpm -r --if-present test",
        "typecheck": "pnpm -r --if-present typecheck",
        "run:db": "pnpm --filter @dkagent/rag-v2 run db:migrate",
        "run:docker": "docker compose -f packages/rag-v2/docker-compose.yml up -d",
        "test:rag-v2": "pnpm --filter @dkagent/rag-v2 test",
        "typecheck:rag-v2": "pnpm --filter @dkagent/rag-v2 typecheck",
        "test:agent-eval": "tsx --test evals/agent-loop/*.test.ts",
        "typecheck:agent-eval": "tsc -p evals/agent-loop/tsconfig.json --noEmit",
        "eval:agent": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 PROMPTFOO_DISABLE_REMOTE_GENERATION=true PROMPTFOO_DISABLE_SHARING=1 PROMPTFOO_CONFIG_DIR=.dkagent/promptfoo NODE_OPTIONS='--import tsx' promptfoo eval -c evals/agent-loop/promptfooconfig.ts --no-cache"
    },
    "devDependencies": {
        "@dkagent/trace": "workspace:*",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.1.2",
        "prettier": "^3.9.6",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
   
